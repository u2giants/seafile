# Lean config-only repo — no node_modules/, dist/, build outputs, or vendored trees to exclude.
# Generated/secret files (also in .gitignore) — never commit or feed to AI context:
__pycache__/
*.pyc
.env
CREDENTIALS.txt
*.sql

