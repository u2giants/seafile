# seaf-cli secrets — copy this file to ".env" in the deployment stack dir
# (/volume1/docker/seaf-cli/.env), fill in the values, and chmod 600.
#
# The real .env is gitignored — NEVER commit it.
# Values come from /opt/seafile/CREDENTIALS.txt on the Seafile server.
#
# Compose loads this automatically via `env_file: - .env` in docker-compose.yml,
# so you just run `sudo docker compose up -d` from the stack dir. Do NOT rely on
# shell-exported vars (sudo strips them) or a one-off --env-file path.

SEAF_USERNAME=nas-sync@popcre.com
SEAF_PASSWORD=
SEAF_STATUS_TOKEN=

# Optional:
# SEAF_TOKEN=            # Seafile API token; if set, used instead of password for verification
# SEAF_UPLOAD_LIMIT=     # KB/s
# SEAF_DOWNLOAD_LIMIT=   # KB/s
# SEAF_ALERT_WEBHOOK_URL=
